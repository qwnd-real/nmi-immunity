;
; nmi-abuse.inf
;
; Primitive driver package: nmi-abuse owns no hardware and binds to no device,
; so it installs a kernel service and nothing else.
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
DriverVer=
CatalogFile=nmi-abuse.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
nmi-abuse.sys = 1,,

[DefaultInstall.NT$ARCH$]
CopyFiles = NmiAbuse.CopyFiles

[DefaultInstall.NT$ARCH$.Services]
AddService = nmi-abuse,0x00000800,NmiAbuse.Service ; SPSVCINST_STARTSERVICE

[NmiAbuse.CopyFiles]
nmi-abuse.sys

[NmiAbuse.Service]
DisplayName   = %ServiceName%
ServiceType   = 1 ; SERVICE_KERNEL_DRIVER
StartType     = 3 ; SERVICE_DEMAND_START
ErrorControl  = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\nmi-abuse.sys

[Strings]
ManufacturerName="<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName="nmi-abuse Source Disk"
ServiceName="nmi-abuse NMI experiment"
